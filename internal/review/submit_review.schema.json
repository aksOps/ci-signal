{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci-signal.local/schema/submit-review-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "completion", "findings", "reassessments", "acknowledgement_changes", "coverage", "limitations"],
  "properties": {
    "verdict": {"enum": ["approved", "needs_review"]},
    "completion": {"enum": ["complete", "partial"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "reassessments": {"type": "array", "items": {"$ref": "#/$defs/reassessment"}},
    "acknowledgement_changes": {"type": "array", "items": {"$ref": "#/$defs/acknowledgement"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4000}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 20000},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation", "source_refs"],
      "properties": {
        "explanation": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "subcategory", "relationship", "title", "explanation", "evidence", "assigned_units"],
      "properties": {
        "category": {"enum": ["blocker", "risk", "question", "info"]},
        "subcategory": {"enum": ["security", "corrections", "reliability", "maintenance", "operational", "info"]},
        "relationship": {"enum": ["introduced", "regressed", "pre_existing", "unknown"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "explanation": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "assigned_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "reassessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "assessment", "explanation", "evidence", "assigned_units"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "assessment": {"enum": ["present", "addressed", "not_applicable", "unknown"]},
        "explanation": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "assigned_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "action", "method", "explanation", "source_refs"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "action": {"enum": ["acknowledge", "reopen"]},
        "method": {"enum": ["ai_discussion", "ai_code_change"]},
        "explanation": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "outcome"],
      "properties": {
        "unit_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["complete", "partial", "failed", "excluded_by_policy"]},
        "explanation": {"type": "string", "maxLength": 4000}
      }
    }
  }
}
